PORT=8082
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hhc_web?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
REDIS_URL=redis://127.0.0.1:6379/2
ENVIRONMENT=development
SHUTDOWN_TIMEOUT=10s
ASSET_API_BASE_URL=http://127.0.0.1:8083
INTERNAL_CALLER_APP_ID=hhc-web-api
APP_API_TOKEN=
ADMIN_ALLOWED_CALLER_APP_ID=api-gateway
ALLOW_DEV_CALLER_HEADER=true
PUBLIC_BASE_URL=http://127.0.0.1:8082/api
OUTBOX_MAX_ATTEMPTS=20
